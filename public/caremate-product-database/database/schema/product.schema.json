{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carematemed.com/schema/product.schema.json",
  "title": "Caremate product record",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "status",
    "reviewStatus",
    "category",
    "subcategory",
    "name",
    "variants",
    "description",
    "features",
    "images",
    "editorialNotes",
    "sortOrder"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": ["draft", "published", "archived"]
    },
    "reviewStatus": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "subcategory": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "name": {
      "$ref": "#/$defs/localizedText"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sku"],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "$ref": "#/$defs/localizedText"
          },
          "specifications": {
            "$ref": "#/$defs/localizedList"
          }
        },
        "additionalProperties": false
      }
    },
    "description": {
      "$ref": "#/$defs/localizedText"
    },
    "features": {
      "$ref": "#/$defs/localizedList"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "file", "alt", "sourceType"],
        "properties": {
          "role": {
            "enum": [
              "hero",
              "gallery",
              "detail",
              "packaging",
              "instruction"
            ]
          },
          "file": {
            "type": "string",
            "pattern": "^images/[A-Za-z0-9][A-Za-z0-9._/-]*\\.(webp|png|jpg|jpeg|avif)$",
            "not": {
              "pattern": "(^|/)\\.{1,2}(/|$)"
            }
          },
          "sourceType": {
            "enum": [
              "catalogue-extracted",
              "replacement",
              "edited"
            ]
          },
          "alt": {
            "$ref": "#/$defs/localizedText"
          },
          "modelSkus": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "editorialNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sortOrder": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": {
          "type": "string"
        },
        "zh": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "localizedList": {
      "type": "object",
      "required": ["en"],
      "properties": {
        "en": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "zh": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
